# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never expose to the client. Used for admin-level DB ops if ever needed.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API
ANTHROPIC_API_KEY=

# Google AI Studio (https://aistudio.google.com/apikey) — used only for
# generative attire correction on profile photos, which Claude can't do
# since it doesn't output images. Leave unset to disable that one step;
# every other photo correction still works without it.
GEMINI_API_KEY=

# Serper.dev (https://serper.dev) — web search for the research agent.
# Free tier is enough for MVP development.
SERPER_API_KEY=

# Set to "true" to use the deterministic mock AI provider instead of
# calling the real Claude API — used automatically by Playwright E2E
# runs (see playwright.config.ts). Leave unset/false for normal dev.
USE_MOCK_AI_PROVIDER=false
